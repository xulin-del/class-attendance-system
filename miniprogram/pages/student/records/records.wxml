<view class="page-container">
  <view class="header">
    <text class="title">我的考勤</text>
  </view>
  
  <view class="content">
    <view class="stats-card">
      <view class="stats-title">考勤统计</view>
      <view class="stats-grid">
        <view class="stat-item signed">
          <text class="stat-value">{{stats.signed}}</text>
          <text class="stat-label">已签到</text>
        </view>
        <view class="stat-item absent">
          <text class="stat-value">{{stats.absent}}</text>
          <text class="stat-label">缺勤</text>
        </view>
        <view class="stat-item total">
          <text class="stat-value">{{stats.total}}</text>
          <text class="stat-label">总记录</text>
        </view>
      </view>
    </view>
    
    <view class="section">
      <view class="section-title">考勤记录</view>
      <view class="record-list">
        <view class="record-item" wx:for="{{records}}" wx:key="recordId">
          <view class="record-left">
            <view class="record-status {{item.statusClass}}">
              <text>{{item.statusText}}</text>
            </view>
          </view>
          <view class="record-info">
            <text class="course-name">课程ID: {{item.courseId}}</text>
            <text class="sign-time" wx:if="{{item.signTime}}">签到时间: {{item.signTime}}</text>
          </view>
          <view class="record-action" wx:if="{{item.status === '缺勤' || item.status === '未签到'}}">
            <view class="apply-btn {{item.applicationStatus ? 'disabled' : ''}}" bindtap="showApplyModal" data-record="{{item}}">
              <text>{{item.applicationStatus === 'pending' ? '申请已提交' : (item.applicationStatus === 'approved' ? '已补签' : (item.applicationStatus === 'rejected' ? '已拒绝' : '申请补签'))}}</text>
            </view>
          </view>
        </view>
        
        <view class="empty" wx:if="{{records.length === 0}}">
          <text class="empty-text">暂无考勤记录</text>
        </view>
      </view>
    </view>
  </view>
  
  <view class="modal-mask" wx:if="{{showApplyModal}}" bindtap="hideApplyModal"></view>
  <view class="modal-container" wx:if="{{showApplyModal}}">
    <view class="modal-header">
      <text class="modal-title">补签申请</text>
      <text class="modal-close" bindtap="hideApplyModal">×</text>
    </view>
    <view class="modal-body">
      <view class="form-item">
        <text class="form-label">课程名称</text>
        <text class="form-value">{{currentRecord.courseName || '课程ID: ' + currentRecord.courseId}}</text>
      </view>
      <view class="form-item">
        <text class="form-label">缺勤日期</text>
        <text class="form-value">{{currentRecord.absenceDate || '未记录'}}</text>
      </view>
      <view class="form-item">
        <text class="form-label">申请理由</text>
        <textarea class="form-textarea" placeholder="请输入申请理由" value="{{applyReason}}" bindinput="onReasonInput" maxlength="200"></textarea>
      </view>
      <view class="form-item">
        <text class="form-label">上传图片（最多3张）</text>
        <view class="image-upload">
          <view class="image-list">
            <view class="image-item" wx:for="{{applyImages}}" wx:key="*this">
              <image src="{{item}}" mode="aspectFill" class="preview-image" bindtap="previewImage" data-url="{{item}}"></image>
              <text class="remove-image" bindtap="removeImage" data-index="{{index}}">×</text>
            </view>
            <view class="add-image" wx:if="{{applyImages.length < 3}}" bindtap="chooseImage">
              <text class="add-icon">+</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view class="modal-footer">
      <button class="cancel-btn" bindtap="hideApplyModal">取消</button>
      <button class="submit-btn" bindtap="submitApplication">提交申请</button>
    </view>
  </view>
  
  <view class="tabbar">
    <view class="tabbar-item" bindtap="switchTab" data-index="0">
      <text class="tabbar-icon">🏠</text>
      <text class="tabbar-text">首页</text>
    </view>
    <view class="tabbar-item" bindtap="switchTab" data-index="1">
      <text class="tabbar-icon">✅</text>
      <text class="tabbar-text">签到中心</text>
    </view>
    <view class="tabbar-item active" bindtap="switchTab" data-index="2">
      <text class="tabbar-icon">📋</text>
      <text class="tabbar-text">我的考勤</text>
    </view>
    <view class="tabbar-item" bindtap="switchTab" data-index="3">
      <text class="tabbar-icon">👤</text>
      <text class="tabbar-text">我的</text>
    </view>
  </view>
</view>
