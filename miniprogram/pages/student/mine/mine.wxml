<view class="page-container">
  <view class="header">
    <view class="user-card">
      <view class="avatar">
        <text class="avatar-text">{{userInfo.studentName ? userInfo.studentName[0] : '学'}}</text>
      </view>
      <view class="user-info">
        <text class="name">{{userInfo.studentName}}</text>
        <text class="id">学号: {{userInfo.studentId}}</text>
        <text class="class">班级: {{userInfo.className}}</text>
      </view>
    </view>
  </view>
  
  <view class="content">
    <view class="menu-card">
      <view class="menu-item" bindtap="goToProfile">
        <view class="menu-left">
          <text class="menu-icon">👤</text>
          <text class="menu-text">个人信息</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      
      <view class="menu-item" bindtap="goToAi">
        <view class="menu-left">
          <text class="menu-icon">🤖</text>
          <text class="menu-text">AI考勤助手</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>

      <view class="menu-item" bindtap="goToMakeup">
        <view class="menu-left">
          <text class="menu-icon">📝</text>
          <text class="menu-text">补签申请</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      
      <view class="menu-item" bindtap="goToHelp">
        <view class="menu-left">
          <text class="menu-icon">📖</text>
          <text class="menu-text">使用帮助</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      
      <view class="menu-item" bindtap="goToSettings">
        <view class="menu-left">
          <text class="menu-icon">⚙️</text>
          <text class="menu-text">系统设置</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
    </view>
    
    <button class="logout-btn" bindtap="handleLogout">退出登录</button>
  </view>
  
  <view class="tabbar">
    <view class="tabbar-item" bindtap="switchTab" data-index="0">
      <text class="tabbar-icon">🏠</text>
      <text class="tabbar-text">首页</text>
    </view>
    <view class="tabbar-item" bindtap="switchTab" data-index="1">
      <text class="tabbar-icon">✅</text>
      <text class="tabbar-text">签到中心</text>
    </view>
    <view class="tabbar-item" bindtap="switchTab" data-index="2">
      <text class="tabbar-icon">📋</text>
      <text class="tabbar-text">我的考勤</text>
    </view>
    <view class="tabbar-item active" bindtap="switchTab" data-index="3">
      <text class="tabbar-icon">👤</text>
      <text class="tabbar-text">我的</text>
    </view>
  </view>
</view>
