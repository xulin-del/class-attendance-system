<view class="page-container">
  <view class="info-card">
    <view class="info-header">
      <view class="avatar-large">
        <text class="avatar-text">{{userInfo.studentName ? userInfo.studentName[0] : '学'}}</text>
      </view>
      <text class="user-name">{{userInfo.studentName}}</text>
    </view>
    
    <view class="info-list">
      <view class="info-item">
        <text class="info-label">学号</text>
        <text class="info-value">{{userInfo.studentId}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">姓名</text>
        <text class="info-value">{{userInfo.studentName}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">班级</text>
        <text class="info-value">{{userInfo.className}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">角色</text>
        <text class="info-value">学生</text>
      </view>
    </view>
  </view>
  
  <view class="section">
    <view class="section-title">账号信息</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="viewAttendance">
        <text class="menu-text">我的考勤记录</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="viewSubscriptions">
        <text class="menu-text">我的订阅</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>
</view>