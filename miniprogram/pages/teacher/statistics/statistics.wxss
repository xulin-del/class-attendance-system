.page-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 120rpx;
}

.header {
  background-color: #fff;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.content {
  padding: 20rpx;
}

.section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.ring-container {
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
  margin: 20rpx 0;
  width: 320rpx;
  height: 320rpx;
  margin-left: auto;
  margin-right: auto;
}

.ring-canvas {
  background-color: transparent;
}

.ring-center {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.ring-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #2E7D32;
}

.ring-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.stats-row {
  display: flex;
  justify-content: space-around;
  margin-top: 30rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-value {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.stats-value.green {
  color: #2E7D32;
}

.stats-value.red {
  color: #ff4d4f;
}

.stats-value.orange {
  color: #fa8c16;
}

.stats-value.gray {
  color: #666;
}

.stats-label {
  font-size: 24rpx;
  color: #999;
}

.chart-container {
  width: 100%;
  display: flex;
  justify-content: center;
  margin-bottom: 20rpx;
}

.bar-canvas {
  background-color: #fff;
}

.chart-legend {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  margin-top: 20rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.legend-color {
  width: 24rpx;
  height: 24rpx;
  border-radius: 4rpx;
}

.legend-green {
  background: linear-gradient(135deg, #43A047 0%, #2E7D32 100%);
}

.legend-text {
  font-size: 24rpx;
  color: #666;
}

.tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: #fff;
  display: flex;
  justify-content: space-around;
  align-items: center;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
}

.tabbar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 20rpx;
}

.tabbar-icon {
  font-size: 40rpx;
  margin-bottom: 4rpx;
}

.tabbar-text {
  font-size: 20rpx;
  color: #999;
}

.tabbar-item.active .tabbar-text {
  color: #2E7D32;
  font-weight: bold;
}
