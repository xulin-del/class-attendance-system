<view class="page-container">
  <view class="header">
    <text class="title">考勤统计</text>
  </view>

  <view class="content">
    <view class="section">
      <view class="section-title">总出勤率</view>
      <view class="ring-container">
        <canvas type="2d" id="ringCanvas" class="ring-canvas" 
          style="width: {{ringSize}}px; height: {{ringSize}}px;">
        </canvas>
        <view class="ring-center">
          <text class="ring-value">{{overallStats.rate || 0}}%</text>
          <text class="ring-label">出勤率</text>
        </view>
      </view>
      <view class="stats-row">
        <view class="stats-item">
          <text class="stats-value green">{{overallStats.signed || 0}}</text>
          <text class="stats-label">已签到</text>
        </view>
        <view class="stats-item">
          <text class="stats-value red">{{overallStats.absent || 0}}</text>
          <text class="stats-label">缺勤</text>
        </view>
        <view class="stats-item">
          <text class="stats-value orange">{{overallStats.late || 0}}</text>
          <text class="stats-label">迟到</text>
        </view>
        <view class="stats-item">
          <text class="stats-value gray">{{overallStats.total || 0}}</text>
          <text class="stats-label">总人次</text>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">近7日出勤趋势</view>
      <view class="chart-container">
        <canvas type="2d" id="barCanvas" class="bar-canvas" 
          style="width: {{chartWidth}}px; height: {{chartHeight}}px;">
        </canvas>
      </view>
      <view class="chart-legend">
        <view class="legend-item">
          <view class="legend-color legend-green"></view>
          <text class="legend-text">出勤率</text>
        </view>
      </view>
    </view>
  </view>

  <view class="tabbar">
    <view class="tabbar-item" bindtap="switchTab" data-index="0">
      <text class="tabbar-icon">🏠</text>
      <text class="tabbar-text">首页</text>
    </view>
    <view class="tabbar-item" bindtap="switchTab" data-index="1">
      <text class="tabbar-icon">📚</text>
      <text class="tabbar-text">课程管理</text>
    </view>
    <view class="tabbar-item" bindtap="switchTab" data-index="2">
      <text class="tabbar-icon">✅</text>
      <text class="tabbar-text">发起签到</text>
    </view>
    <view class="tabbar-item active" bindtap="switchTab" data-index="3">
      <text class="tabbar-icon">📊</text>
      <text class="tabbar-text">考勤统计</text>
    </view>
    <view class="tabbar-item" bindtap="switchTab" data-index="4">
      <text class="tabbar-icon">👤</text>
      <text class="tabbar-text">我的</text>
    </view>
  </view>
</view>
