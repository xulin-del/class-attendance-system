<view class="page-container">
  <view class="header">
    <text class="title">补签审批</text>
  </view>
  
  <view class="content">
    <view class="application-list" wx:if="{{applications.length > 0}}">
      <view class="application-card" wx:for="{{applications}}" wx:key="id">
        <view class="card-header">
          <text class="student-name">{{item.studentName || '学生'}}</text>
          <text class="apply-time">{{item.createTime}}</text>
        </view>
        
        <view class="card-body">
          <view class="info-row">
            <text class="info-label">课程：</text>
            <text class="info-value">{{item.courseName || '课程ID: ' + item.courseId}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">缺勤日期：</text>
            <text class="info-value">{{item.absenceDate}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">申请理由：</text>
            <text class="info-value">{{item.reason}}</text>
          </view>
          
          <view class="image-section" wx:if="{{item.imageList.length > 0}}">
            <text class="info-label">附件图片：</text>
            <view class="image-list">
              <image wx:for="{{item.imageList}}" wx:key="*this" wx:for-item="img" src="{{img}}" mode="aspectFill" class="preview-img" bindtap="previewImage" data-url="{{img}}" data-urls="{{item.imageList}}"></image>
            </view>
          </view>
        </view>
        
        <view class="card-footer">
          <view class="btn approve-btn" bindtap="approveApplication" data-id="{{item.id}}">通过</view>
          <view class="btn reject-btn" bindtap="showRejectModal" data-id="{{item.id}}">拒绝</view>
        </view>
      </view>
    </view>
    
    <view class="empty" wx:else>
      <text class="empty-text">暂无待审批申请</text>
    </view>
  </view>
  
  <view class="modal-mask" wx:if="{{showRejectModal}}" bindtap="hideRejectModal"></view>
  <view class="modal-container" wx:if="{{showRejectModal}}">
    <view class="modal-header">
      <text class="modal-title">拒绝原因</text>
      <text class="modal-close" bindtap="hideRejectModal">×</text>
    </view>
    <view class="modal-body">
      <textarea class="reject-textarea" placeholder="请输入拒绝原因（可选）" value="{{rejectReason}}" bindinput="onRejectReasonInput" maxlength="200"></textarea>
    </view>
    <view class="modal-footer">
      <button class="cancel-btn" bindtap="hideRejectModal">取消</button>
      <button class="confirm-btn" bindtap="rejectApplication">确认拒绝</button>
    </view>
  </view>
</view>
