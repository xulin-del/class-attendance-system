<view class="page-container">
  <view class="info-card">
    <view class="info-header">
      <view class="avatar-large">
        <text class="avatar-text">{{userInfo.teacherName ? userInfo.teacherName[0] : '教'}}</text>
      </view>
      <text class="user-name">{{userInfo.teacherName}}</text>
    </view>
    
    <view class="info-list">
      <view class="info-item">
        <text class="info-label">工号</text>
        <text class="info-value">{{userInfo.teacherId}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">姓名</text>
        <text class="info-value">{{userInfo.teacherName}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">角色</text>
        <text class="info-value">教师</text>
      </view>
    </view>
  </view>
  
  <view class="section">
    <view class="section-title">账号安全</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="changePassword">
        <text class="menu-text">修改密码</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>
</view>