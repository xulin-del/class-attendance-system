.page-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx;
  padding-bottom: 40rpx;
}

.header-bar {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 20rpx;
}

.add-btn {
  background: linear-gradient(135deg, #1677FF, #69b1ff);
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(22, 119, 255, 0.3);
}

.add-btn-text {
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
}

.week-view {
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.week-header {
  display: flex;
  border-bottom: 1rpx solid #f0f0f0;
}

.week-day {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
}

.day-name {
  font-size: 24rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 4rpx;
}

.day-date {
  font-size: 20rpx;
  color: #999;
}

.week-body {
  display: flex;
  min-height: 400rpx;
}

.time-column {
  width: 80rpx;
  flex-shrink: 0;
  border-right: 1rpx solid #f0f0f0;
}

.time-slot {
  height: 100rpx;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: 8rpx;
}

.time-text {
  font-size: 18rpx;
  color: #999;
}

.schedule-grid {
  flex: 1;
  display: flex;
}

.day-column {
  flex: 1;
  border-right: 1rpx solid #f5f5f5;
}

.day-column:last-child {
  border-right: none;
}

.cell {
  height: 100rpx;
  border-bottom: 1rpx solid #f5f5f5;
  padding: 4rpx;
  position: relative;
}

.schedule-card {
  background: #1677FF;
  border-radius: 8rpx;
  padding: 8rpx;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.card-course {
  color: #fff;
  font-size: 18rpx;
  font-weight: bold;
  margin-bottom: 2rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.card-class {
  color: rgba(255, 255, 255, 0.85);
  font-size: 14rpx;
  margin-bottom: 2rpx;
}

.card-time {
  color: rgba(255, 255, 255, 0.7);
  font-size: 14rpx;
}

.card-location {
  color: rgba(255, 255, 255, 0.7);
  font-size: 14rpx;
}

.schedule-list {
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.list-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  padding: 24rpx 30rpx 16rpx;
  border-left: 6rpx solid #1677FF;
  margin-left: 30rpx;
}

.schedule-item {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.schedule-item:last-child {
  border-bottom: none;
}

.item-color {
  width: 12rpx;
  height: 80rpx;
  border-radius: 6rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.item-course {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 6rpx;
}

.item-detail {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 4rpx;
}

.item-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
}

.edit-btn {
  background-color: #f0f5ff;
}

.delete-btn {
  background-color: #fff2f0;
}

.action-text {
  font-size: 24rpx;
}

.edit-btn .action-text {
  color: #1677FF;
}

.delete-btn .action-text {
  color: #ff4d4f;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #ccc;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.modal {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 30rpx;
  z-index: 101;
  max-height: 80vh;
  overflow-y: auto;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 30rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-item.half {
  flex: 1;
}

.form-row {
  display: flex;
  gap: 20rpx;
}

.form-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
  display: block;
}

.form-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
}

.form-input {
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
}

.picker-arrow {
  font-size: 24rpx;
  color: #999;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.modal-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.cancel-btn {
  background-color: #f5f5f5;
  color: #666;
}

.confirm-btn {
  background: linear-gradient(135deg, #1677FF, #69b1ff);
  color: #fff;
}
